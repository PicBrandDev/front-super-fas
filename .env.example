# ---- Desenvolvimento (npm run dev) ----
# Sem API_URL o app usa os dados de exemplo (src/lib/mock.ts) e não pede login.
# Com a API rodando (back-super-fas), defina as duas abaixo num .env.local:
# API_URL=http://localhost:8000
# JWT_SECRET=o-mesmo-valor-do-back

# ---- Marca da plataforma (white label; opcional) ----
# Nome, selo (1–2 letras), legenda e cor dos painéis, do portal do patrocinador e das telas de conta.
# Sem valor: "Super Fãs", "S", "Plataforma de fã clubes" e azul #2F5BD3.
# NEXT_PUBLIC_PLATFORM_NAME=
# NEXT_PUBLIC_PLATFORM_MARK=
# NEXT_PUBLIC_PLATFORM_TAGLINE=
# NEXT_PUBLIC_PLATFORM_COLOR=

# ---- Servidor (docker compose) ----
# Copie este arquivo para .env na pasta do servidor e preencha.
# Gere valores com: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
# Senha das contas de teste criadas na primeira subida (vazio = aleatória, aparece em: docker compose logs api)
SEED_PASSWORD=

# Opcionais (deixe como está para manter desligado):
# Endereço público do site (links dos e-mails de convite).
# APP_URL=https://fa-clube.picbrand.com.br
# E-mail de convite do dono de fã clube (SMTP).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Super Fãs <nao-responda@picbrand.com.br>
# Photo Finder com reconhecimento facial (AWS Rekognition).
# REKOGNITION_ENABLED=true
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Para usar fotos já indexadas (coleção do Rekognition + bucket do S3), preencha também:
# DEMO_PHOTO_TICKET=true
# REKOGNITION_COLLECTION_ID=
# S3_BUCKET=
# PRESIGNED_URL_EXPIRES_SECONDS=3600
# S3_PHOTO_PREFIX=photos/original/
# S3_PHOTO_SUFFIX=.jpg
# Ranking Fã Super: confere no Instagram os posts com a hashtag (API da Meta).
# INSTAGRAM_ENABLED=true
# INSTAGRAM_USER_ID=
# INSTAGRAM_ACCESS_TOKEN=
